# EventHub deployment secrets — copy to `infra/.env` and fill in. The real file (`infra/.env`)
# is gitignored; only this .example is committed. Load it into your PowerShell session with:
#
#     cd infra; . ./load-env.ps1
#
# After loading: `terraform` picks up TF_VAR_*/AWS_* automatically, and `k8s/seal.ps1` reads the
# EVENTHUB_* values (falling back to prompts for anything left blank).
#
# IMPORTANT: put values on their own line, e.g.  TF_VAR_domain=eskimos.me
# Do NOT add a comment after the value on the same line.

# ── DigitalOcean — Terraform + CD cluster auth ──
# DO Personal Access Token (scope: read + write). Same token CD uses (already a repo secret).
TF_VAR_do_token=

# ── DO Spaces — Terraform remote-state backend (see infra/terraform/backend.tf) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Terraform variables — cluster / DNS / TLS ──
# Apex domain delegated to DO nameservers, e.g. eskimos.me
TF_VAR_domain=
# Contact email for Let's Encrypt expiry notices (any inbox you own).
TF_VAR_acme_email=
# DO region (must match your Spaces bucket region).
TF_VAR_region=fra1
# Leave BLANK on the first apply; set to the ingress LB IP, then re-apply.
TF_VAR_lb_ip=

# ── Sealed secrets — entered into k8s/seal.ps1 at gate 9 (kubeseal encrypts these) ──
# Postgres superuser/app role (eventhub) password.
EVENTHUB_PG_PASSWORD=
# api_reader login password (read-only access to events).
EVENTHUB_API_READER_PASSWORD=
# Discord webhook URL for #eventhub-alerts (also a repo secret).
EVENTHUB_DISCORD_WEBHOOK=
# GitHub username/org that owns the GHCR packages.
EVENTHUB_GHCR_USER=
# GitHub classic PAT, scope: read:packages (for the image pull secret).
EVENTHUB_GHCR_TOKEN=
