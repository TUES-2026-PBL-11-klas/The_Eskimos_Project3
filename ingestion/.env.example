DATABASE_URL=postgresql+asyncpg://eventhub:eventhub@localhost:5432/eventhub

# --- Public API sources ---
# Bandsintown: self-assigned identifier string (no OAuth, no secret). Artist-centric.
BANDSINTOWN_APP_ID=eventhub-school-project
BANDSINTOWN_ARTISTS=Massive Attack,Eric Prydz,Hans Zimmer
# Ticketmaster Discovery: free API key (get one at developer.ticketmaster.com). Never commit a real key.
TICKETMASTER_API_KEY=

# --- Scraper runtime ---
SCRAPE_MAX_CONCURRENCY=5
HTTP_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
